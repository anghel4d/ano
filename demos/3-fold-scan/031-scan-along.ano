-- along names the traversal itself. Associative, non-associative, extremum, and prefix-machine heads all consume exactly this order; they never align a same-length buffer by accident.
--! registry ../registries/031-scan-along.reg

--! out 2 5 9 10
scan(+) Weight along pathCells

--! out 2 -1 -5 -6
scan(-) Weight along pathCells

--! out 2 2 2 1
scan(min) Weight along pathCells

--! out 2 2.5 3 2.5
scan(avg) Weight along pathCells

--! out 1 4 6 10
+\ Weight @ Mask

--! out 10
+/ Weight @ Mask
