-- Five fighters, but the predicates now have names: def binds a selection, and master and rich thereafter stand for the whole mask.
--! registry ../registries/009-named-selections.reg
--! expect gold = 10500 3000 20000 15000 500
--! expect faction = Hostile Friendly Hostile Hostile Friendly
--! expect marked = 1 0 1 1 0
--! expect legendary = 1 0 0 0 0

def master = Human & Nord & TwoHanded > 60
def rich   = Gold > 10000
master , Gold += 1000
rich , Faction = :Hostile ; +Marked
master & rich , +Legendary
