--! registry ../registries/005-target-aliases.reg
--! expect health = 50 60 0 80 90
--! expect faction = None Friendly None None None
--! expect gold = 10000 2 3 4 5
--! expect damage = 10 20 60 80 50

^cursor , Health = 0
^observer , Faction = :Friendly
Player , Gold += 9999
^selected , Damage *= 2
