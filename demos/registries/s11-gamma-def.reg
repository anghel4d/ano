# s11 — gamma primitive fixture (mirrors demos/8-gamma/s11-gamma-def.bqn)
# One world: rows 0-4 sources, rows 5-8 targets. .bqn ids 0 0 2 2 2 / vals 3 5 2 4 9 / flags 1 0 0 0 1.
# rto remaps the .bqn ids to the concatenated layout; target rows dangle (-1). Target-row v/f values are decoys, never read through fibers (f row 6 = 1 catches an own-row any read, f row 8 = 0 catches an own-row all read).
# Result columns start at -1 sentinels: avg's dropped rows (6, 8) must keep them.
n 9
col source bool 1 1 1 1 1 0 0 0 0
col target bool 0 0 0 0 0 1 1 1 1
col picked bool 0 0 0 0 0 1 0 1 0
col v num 3 5 2 4 9 99 99 99 99
col f bool 1 0 0 0 1 0 1 0 0
col cCount num -1 -1 -1 -1 -1 -1 -1 -1 -1
col cSum num -1 -1 -1 -1 -1 -1 -1 -1 -1
col cAny num -1 -1 -1 -1 -1 -1 -1 -1 -1
col cAll num -1 -1 -1 -1 -1 -1 -1 -1 -1
col cAvg num -1 -1 -1 -1 -1 -1 -1 -1 -1
col cPick num -1 -1 -1 -1 -1 -1 -1 -1 -1
rel rto 5 5 7 7 7 -1 -1 -1 -1
inv r rto
ja 源 source
ja 標的物 target
ja 選択 picked
ja 前 prev
ja 行 row
ja 番号 index
ja 字 char
