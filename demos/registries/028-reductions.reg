# Reductions over live scopes: the sidecar's party mask is a dynamic selection and empty is a
# dynamic selection of nothing. +/ and */ carry declared identities; max/ and avg/ declare
# none, so their empty scopes have no result row; #/ declares 0.
n 8
col nord bool 1 0 1 1 0 1 0 0
col gold nat 100 50 20 5 0 25 7 3
col hits bool 0 1 1 0 0 1 0 0
col resist num 0 0.25 0.5 0 0 0.75 0 0
ja 北 nord
ja 金 gold
ja 命中 hits
ja 抵抗 resist
