# ex35 replicate row (mirrors demos/7-tiers/35-two-habitats.bqn)
# four sources; parent -1 = unspawned original; minted parents come from the registered parent column.
n 4
col unit bool 1 1 1 1
col minion bool 0 0 0 0
col tree bool 0 0 0 0
col count num 2 0 1 3
col density num 1 0 2 1
col parent num -1 -1 -1 -1
