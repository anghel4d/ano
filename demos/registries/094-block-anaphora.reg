# archetype bool columns mirror the type strings exactly: nord/imperial/khajiit partition the six rows; no ghosts pre-state.
n 6
col type sym nord nord imperial nord nord khajiit
col nord bool 1 1 0 1 1 0
col dead bool 1 0 0 1 0 0
col imperial bool 0 0 1 0 0 0
col khajiit bool 0 0 0 0 0 1
col ghost bool 0 0 0 0 0 0
def wraith ghost=1 type=ghost
ja 種別 type
ja 北 nord
ja 死 dead
ja 帝国 imperial
ja カジート khajiit
ja 幽霊 ghost
ja 亡霊 wraith
