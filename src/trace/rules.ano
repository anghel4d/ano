-- Two standing rules crossing one relationship in one tick. Each rule carries its own
-- statement mask, so each crossing scopes to its own S and mints its own use record.
--! registry rules-world
--! expect gold = 0 5 0 0 0
--! expect morale = 100 100 80 90 60

def bless = Nord & mentor.Dead => Gold += 5
def drain = Nord => Morale = mentor.Morale
